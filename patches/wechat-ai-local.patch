diff --git a/src/wechat_ai_bot/mcp/feeds.py b/src/wechat_ai_bot/mcp/feeds.py
new file mode 100644
index 0000000..8b977bd
--- /dev/null
+++ b/src/wechat_ai_bot/mcp/feeds.py
@@ -0,0 +1,286 @@
+"""Read-only Moments (SNS) and official-account (biz) feeds from Linux WeChat DBs.
+
+The desktop client only stores Moments that were loaded in its GUI and
+official-account pushes received while it was logged in.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import re
+import xml.etree.ElementTree as ET
+from typing import Any, Callable, Optional
+
+from wechat_ai_bot.weixin.message_content import message_content_text
+
+SNS_DB = "sns/sns.db"
+BIZ_DB_RE = re.compile(r"^message/biz_message_\d+\.db$")
+
+SNS_CONTENT_TYPES = {
+    1: "图片",
+    2: "文字",
+    3: "链接",
+    4: "音乐",
+    5: "视频",
+    7: "图片",
+    15: "视频",
+    28: "视频号",
+    34: "视频号",
+}
+
+ContactName = Callable[[str], str]
+
+
+def _parse_xml(text: str) -> Optional[ET.Element]:
+    if not text:
+        return None
+    start = text.find("<")
+    if start < 0:
+        return None
+    try:
+        return ET.fromstring(text[start:])
+    except ET.ParseError:
+        return None
+
+
+def _text(node: Optional[ET.Element], path: str) -> str:
+    if node is None:
+        return ""
+    found = node.find(path)
+    return (found.text or "").strip() if found is not None and found.text else ""
+
+
+def _int(value: Any) -> int:
+    try:
+        return int(value or 0)
+    except (TypeError, ValueError):
+        return 0
+
+
+def _in_range(ts: int, start: Optional[int], end: Optional[int]) -> bool:
+    return (start is None or ts >= start) and (end is None or ts <= end)
+
+
+def _rows(db: Any, path: Any, sql: str, params: tuple = ()) -> list[tuple]:
+    try:
+        return db.execute_query(path, sql, params)
+    except Exception:
+        return []
+
+
+def parse_sns_item(content: str) -> dict[str, Any]:
+    root = _parse_xml(content)
+    timeline = root.find(".//TimelineObject") if root is not None else None
+    if timeline is None:
+        return {"raw": content[:500]}
+    content_obj = timeline.find("ContentObject")
+    content_type = _int(_text(content_obj, "type"))
+    media = []
+    for item in timeline.findall("./ContentObject/mediaList/media"):
+        media.append(
+            {
+                "type": _int(_text(item, "type")),
+                "url": _text(item, "url"),
+                "thumb": _text(item, "thumb"),
+                "title": _text(item, "title"),
+                "description": _text(item, "description"),
+            }
+        )
+    location = timeline.find("location")
+    place = ""
+    if location is not None:
+        place = location.get("poiName") or location.get("city") or ""
+    return {
+        "id": _text(timeline, "id"),
+        "username": _text(timeline, "username"),
+        "nickname": _text(root, ".//LocalExtraInfo/nickname"),
+        "create_time": _int(_text(timeline, "createTime")),
+        "text": _text(timeline, "contentDesc"),
+        "content_type": content_type,
+        "content_type_name": SNS_CONTENT_TYPES.get(content_type, str(content_type)),
+        "link_title": _text(content_obj, "title"),
+        "link_description": _text(content_obj, "description"),
+        "link_url": _text(content_obj, "contentUrl"),
+        "location": place,
+        "media": media,
+    }
+
+
+def moments_feed(
+    db: Any,
+    contact_name: ContactName,
+    *,
+    username: str = "",
+    start_timestamp: Optional[int] = None,
+    end_timestamp: Optional[int] = None,
+    limit: int = 50,
+) -> dict[str, Any]:
+    path = db._db(SNS_DB)
+    if not path:
+        return {"status": "unavailable", "message": f"{SNS_DB} not found or has no SQLCipher key"}
+
+    posts = []
+    for (content,) in _rows(db, path, "select content from SnsTimeLine"):
+        post = parse_sns_item(message_content_text(content))
+        ts = post.get("create_time", 0)
+        if username and post.get("username") != username:
+            continue
+        if not _in_range(ts, start_timestamp, end_timestamp):
+            continue
+        post["author"] = post.get("nickname") or contact_name(post.get("username", ""))
+        posts.append(post)
+    posts.sort(key=lambda p: p.get("create_time", 0), reverse=True)
+
+    notices: dict[Any, dict[str, Any]] = {}
+    for tid, user, summary, ts in _rows(db, path, "select tid, username, summary, create_time from SnsTopItem_1"):
+        ts = _int(ts)
+        if (username and user != username) or not _in_range(ts, start_timestamp, end_timestamp):
+            continue
+        notices[tid] = {
+            "username": user,
+            "author": contact_name(user),
+            "summary": message_content_text(summary),
+            "create_time": ts,
+        }
+
+    interactions = []
+    for row in _rows(
+        db,
+        path,
+        "select create_time, type, feed_id, is_unread, from_username, from_nickname, content "
+        "from SnsMessage_tmp3 order by create_time desc",
+    ):
+        ts, kind, feed_id, unread, from_user, from_nick, text = row
+        ts = _int(ts)
+        if not _in_range(ts, start_timestamp, end_timestamp):
+            continue
+        interactions.append(
+            {
+                "create_time": ts,
+                "type": kind,
+                "feed_id": str(feed_id or ""),
+                "is_unread": bool(unread),
+                "from_username": from_user or "",
+                "from_display": from_nick or contact_name(from_user or ""),
+                "text": message_content_text(text),
+            }
+        )
+
+    return {
+        "status": "ok",
+        "note": "Only Moments loaded in the desktop WeChat GUI are cached locally.",
+        "post_count": len(posts),
+        "posts": posts[:limit],
+        "new_post_notices": sorted(notices.values(), key=lambda n: n["create_time"], reverse=True)[:limit],
+        "interactions": interactions[:limit],
+    }
+
+
+def parse_biz_message(text: str) -> dict[str, Any]:
+    root = _parse_xml(text)
+    if root is None:
+        return {"kind": "text", "text": text.strip()[:2000], "articles": []}
+    appmsg = root.find(".//appmsg")
+    articles = []
+    for item in root.findall(".//mmreader/category/item"):
+        title = _text(item, "title")
+        if not title:
+            continue
+        articles.append(
+            {
+                "title": title,
+                "digest": _text(item, "digest"),
+                "url": _text(item, "url"),
+                "pub_time": _int(_text(item, "pub_time")),
+            }
+        )
+    if not articles and appmsg is not None and _text(appmsg, "title"):
+        articles.append(
+            {
+                "title": _text(appmsg, "title"),
+                "digest": _text(appmsg, "des"),
+                "url": _text(appmsg, "url"),
+                "pub_time": 0,
+            }
+        )
+    return {
+        "kind": "articles" if articles else "xml",
+        "publisher": _text(root, ".//mmreader/publisher/nickname") or _text(root, ".//mmreader/category/name"),
+        "articles": articles,
+        "text": "" if articles else _text(appmsg, "title")[:2000],
+    }
+
+
+def official_account_feed(
+    db: Any,
+    contact_name: ContactName,
+    *,
+    username: str = "",
+    start_timestamp: Optional[int] = None,
+    end_timestamp: Optional[int] = None,
+    limit: int = 100,
+) -> dict[str, Any]:
+    paths = []
+    missing_keys = []
+    for account in db._accounts_for_queries():
+        for relative, path in sorted(account.databases.items()):
+            if BIZ_DB_RE.match(relative):
+                (paths if db._has_key(path) else missing_keys).append(path)
+    if not paths:
+        return {
+            "status": "unavailable",
+            "message": "No readable message/biz_message_*.db",
+            "missing_keys": [p.name for p in missing_keys],
+        }
+
+    clauses, params = [], []
+    if start_timestamp is not None:
+        clauses.append("create_time >= ?")
+        params.append(int(start_timestamp))
+    if end_timestamp is not None:
+        clauses.append("create_time <= ?")
+        params.append(int(end_timestamp))
+    where = f"where {' and '.join(clauses)}" if clauses else ""
+
+    pushes = []
+    for path in paths:
+        names = {
+            hashlib.md5(str(user).encode()).hexdigest(): str(user)
+            for (user,) in _rows(db, path, "select user_name from Name2Id")
+            if user
+        }
+        if username:
+            table = f"Msg_{hashlib.md5(username.encode()).hexdigest()}"
+            tables = [table] if table[4:] in names else []
+        else:
+            tables = [
+                name
+                for (name,) in _rows(db, path, "select name from sqlite_master where type='table' and name like 'Msg_%'")
+            ]
+        for table in tables:
+            user = names.get(table[4:], "")
+            sql = (
+                f'select create_time, local_type, message_content, WCDB_CT_message_content '
+                f'from "{table}" {where} order by create_time desc limit ?'
+            )
+            for ts, local_type, content, ct_flag in _rows(db, path, sql, (*params, int(limit))):
+                parsed = parse_biz_message(message_content_text(content, ct_flag))
+                pushes.append(
+                    {
+                        "username": user,
+                        "account": contact_name(user) or parsed.get("publisher") or user,
+                        "create_time": _int(ts),
+                        "local_type": local_type,
+                        **parsed,
+                    }
+                )
+    pushes.sort(key=lambda p: p["create_time"], reverse=True)
+    pushes = pushes[:limit]
+    return {
+        "status": "ok",
+        "note": "Only pushes received while desktop WeChat was logged in are stored locally.",
+        "count": len(pushes),
+        "article_count": sum(len(p["articles"]) for p in pushes),
+        "missing_keys": [p.name for p in missing_keys],
+        "pushes": pushes,
+    }
