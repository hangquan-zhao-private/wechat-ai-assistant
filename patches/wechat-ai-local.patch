index 0000000..1a49ab9
--- /dev/null
+++ b/tests/test_feeds.py
@@ -0,0 +1,95 @@
+import hashlib
+from pathlib import Path
+from types import SimpleNamespace
+
+from wechat_ai_bot.mcp.feeds import moments_feed, official_account_feed, parse_biz_message, parse_sns_item
+
+SNS_XML = (
+    "<SnsDataItem><TimelineObject><id>1</id><username>wxid_a</username>"
+    "<createTime>1793314162</createTime><contentDesc>周末爬山</contentDesc>"
+    '<location poiName="Mount Si" city="Seattle"/>'
+    "<ContentObject><type>1</type><mediaList><media><type>2</type>"
+    "<url>http://img/0</url><thumb>http://img/150</thumb></media></mediaList></ContentObject>"
+    "</TimelineObject><LocalExtraInfo><nickname>Alice</nickname></LocalExtraInfo></SnsDataItem>"
+)
+
+BIZ_XML = (
+    "<msg><appmsg><title>头条</title><des>摘要</des><mmreader>"
+    "<category count=\"2\"><name>北美内推鹅</name>"
+    "<item><title><![CDATA[岗位A]]></title><url>http://a</url><digest>H-1B</digest><pub_time>1793321448</pub_time></item>"
+    "<item><title>岗位B</title><url>http://b</url></item>"
+    "</category><publisher><nickname>北美内推鹅</nickname></publisher></mmreader></appmsg></msg>"
+)
+
+
+class FakeDb:
+    def __init__(self, tables):
+        self.tables = tables
+        self.sns = Path("/x/sns/sns.db")
+        self.biz = Path("/x/message/biz_message_0.db")
+        self.account = SimpleNamespace(databases={"sns/sns.db": self.sns, "message/biz_message_0.db": self.biz})
+
+    def _db(self, relative):
+        return self.account.databases.get(relative)
+
+    def _accounts_for_queries(self):
+        return [self.account]
+
+    def _has_key(self, path):
+        return True
+
+    def execute_query(self, path, sql, params=()):
+        for name, rows in self.tables.items():
+            if name in sql:
+                return rows
+        return []
+
+
+def test_parse_sns_item_extracts_text_media_location():
+    post = parse_sns_item(SNS_XML)
+    assert post["text"] == "周末爬山"
+    assert post["nickname"] == "Alice"
+    assert post["location"] == "Mount Si"
+    assert post["content_type_name"] == "图片"
+    assert post["media"][0]["url"] == "http://img/0"
+
+
+def test_moments_feed_dedupes_notices_and_filters_time():
+    db = FakeDb(
+        {
+            "SnsTimeLine": [(SNS_XML,)],
+            "SnsTopItem_1": [(5, "wxid_b", "", 1793318429), (5, "wxid_b", "", 1793318429)],
+            "SnsMessage_tmp3": [],
+        }
+    )
+    payload = moments_feed(db, lambda u: {"wxid_b": "Bob"}.get(u, ""))
+    assert payload["post_count"] == 1
+    assert payload["posts"][0]["author"] == "Alice"
+    assert [n["author"] for n in payload["new_post_notices"]] == ["Bob"]
+
+    later = moments_feed(db, lambda u: "", start_timestamp=1793318000)
+    assert later["post_count"] == 0
+    assert len(later["new_post_notices"]) == 1
+
+
+def test_parse_biz_message_prefers_mmreader_items():
+    parsed = parse_biz_message(BIZ_XML)
+    assert [a["title"] for a in parsed["articles"]] == ["岗位A", "岗位B"]
+    assert parsed["articles"][0]["digest"] == "H-1B"
+    assert parsed["publisher"] == "北美内推鹅"
+
+
+def test_official_account_feed_maps_table_to_account():
+    user = "gh_d7f5a2ed3f08"
+    table = f"Msg_{hashlib.md5(user.encode()).hexdigest()}"
+    db = FakeDb(
+        {
+            "Name2Id": [(user,)],
+            "sqlite_master": [(table,)],
+            table: [(1793321448, 49, BIZ_XML, 0)],
+        }
+    )
+    payload = official_account_feed(db, lambda u: "北美内推鹅" if u == user else "")
+    assert payload["count"] == 1
+    assert payload["article_count"] == 2
+    assert payload["pushes"][0]["account"] == "北美内推鹅"
