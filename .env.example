# Copy values from vendor/wechat-ai/.env after first setup.
# Used by the personal agent CLI and Cursor MCP bridge.

WECHAT_AI_MCP_URL=http://127.0.0.1:8000/mcp
WECHAT_AI_MCP_TOKEN=replace-with-token-from-vendor-wechat-ai-env

# Email briefing (scripts/digest.sh). Gmail app password: https://myaccount.google.com/apppasswords
DIGEST_GMAIL_ADDRESS=you@gmail.com
DIGEST_GMAIL_APP_PASSWORD=
DIGEST_TO=you@gmail.com
DIGEST_MY_NAMES=你的微信昵称
# One of these for the AI summary; DIGEST_LLM_MODEL overrides the default model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Group news post (scripts/group_post.sh)
GROUP_POST_TARGET=

# Family news post (scripts/family_post.sh); see README for a sample.
FAMILY_POST_TARGET=
FAMILY_POST_SON_NAME=
FAMILY_POST_HOME=
FAMILY_POST_WORK_CITY=
FAMILY_POST_COMPANY=
FAMILY_POST_LOCAL_SPOTS=
FAMILY_POST_LOCAL_INDUSTRIES=

# Moments stocks topic: extra tickers, comma-separated (optional)
MOMENTS_EXTRA_TICKERS=
